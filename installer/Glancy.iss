; Glancy setup: the settings app and the thumbnail engine, per user, without administrator rights.
; Built by tools/build-installer.ps1, which passes AppVersion, AppDir (self-contained app) and EngineDir (dist/Engine).
; Design: the engine DLL is loaded inside File Explorer, so it is never overwritten or deleted in place: in-use files
; are renamed (upgrade) or moved to the temp folder and deleted at the next sign-in (uninstall).

#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif
#ifndef AppDir
  #define AppDir "..\dist\Installer\app"
#endif
#ifndef EngineDir
  #define EngineDir "..\dist\Engine"
#endif

[Setup]
; Fixed forever: later versions upgrade the same installation.
AppId={{57BE6CE7-E3A9-409E-9D9B-3C6BE3EAB064}
AppName=Glancy
AppVersion={#AppVersion}
AppVerName=Glancy {#AppVersion}
AppPublisher=Glancy
AppCopyright=© 2026 Sergio Cespedes
AppPublisherURL=https://github.com/sergiocespedesp/glancy
AppSupportURL=https://github.com/sergiocespedesp/glancy/issues
AppUpdatesURL=https://github.com/sergiocespedesp/glancy/releases
VersionInfoVersion={#AppVersion}
VersionInfoProductName=Glancy
VersionInfoDescription=Glancy Setup
DefaultDirName={userpf}\Glancy
DisableDirPage=yes
DefaultGroupName=Glancy
DisableProgramGroupPage=yes
DisableWelcomePage=no
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.19041
WizardStyle=modern
; Generated by tools/make_icon.py; Setup picks the size closest to the display scale.
WizardImageFile=images\wizard-100.bmp,images\wizard-125.bmp,images\wizard-150.bmp,images\wizard-175.bmp,images\wizard-200.bmp,images\wizard-225.bmp,images\wizard-250.bmp
WizardSmallImageFile=images\wizard-small-100.bmp,images\wizard-small-125.bmp,images\wizard-small-150.bmp,images\wizard-small-175.bmp,images\wizard-small-200.bmp,images\wizard-small-225.bmp,images\wizard-small-250.bmp
SetupIconFile=..\src\Glancy.Settings\Assets\Glancy.ico
UninstallDisplayIcon={app}\Glancy.exe
UninstallDisplayName=Glancy
Compression=lzma2/ultra64
SolidCompression=yes
LZMAUseSeparateProcess=yes
; Restart Manager may close only the settings app. Explorer also has engine files open; those are handled in
; PrepareToInstall and must never make Setup close Explorer.
CloseApplications=yes
CloseApplicationsFilter=Glancy.exe
RestartApplications=no
ShowLanguageDialog=no
OutputBaseFilename=GlancySetup-{#AppVersion}

[Languages]
Name: "en"; MessagesFile: "compiler:Default.isl"
Name: "es"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "de"; MessagesFile: "compiler:Languages\German.isl"
Name: "fr"; MessagesFile: "compiler:Languages\French.isl"
Name: "ptbr"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
Name: "ja"; MessagesFile: "compiler:Languages\Japanese.isl"
Name: "zhhans"; MessagesFile: "languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "{#AppDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#EngineDir}\*"; DestDir: "{app}\Engine"; Flags: ignoreversion recursesubdirs createallsubdirs
; GPL-3.0 section 4: every copy carries the license text.
Source: "..\LICENSE"; DestDir: "{app}"; DestName: "LICENSE.txt"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\Glancy"; Filename: "{app}\Glancy.exe"
Name: "{autodesktop}\Glancy"; Filename: "{app}\Glancy.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\Glancy.exe"; Description: "{cm:LaunchProgram,Glancy}"; Flags: nowait postinstall skipifsilent

[CustomMessages]
en.EngineRegisterFailed=Glancy was installed, but its thumbnail engine could not be registered (error %1). Thumbnails won't change until it is. Run this setup again to retry.
en.EngineUnregisterFailed=The thumbnail engine could not be unregistered completely (error %1). The backups of the previous thumbnail handlers were kept. To retry, install Glancy again and then uninstall it.
en.DeleteSettings=Also delete your Glancy settings and the history of processed files?%n%nChoose No if you might install Glancy again.
en.RenameFailed=Setup can't replace %1 because another program is using it. Close File Explorer windows and try again.
es.EngineRegisterFailed=Glancy se ha instalado, pero no se pudo registrar su motor de miniaturas (error %1). Las miniaturas no cambiarán hasta que se registre. Vuelve a ejecutar este instalador para intentarlo de nuevo.
es.EngineUnregisterFailed=No se pudo desregistrar por completo el motor de miniaturas (error %1). Se han conservado las copias de seguridad de los controladores de miniaturas anteriores. Para volver a intentarlo, instala Glancy de nuevo y desinstálalo.
es.DeleteSettings=¿Quieres borrar también tus ajustes de Glancy y el historial de archivos procesados?%n%nElige No si quizá vuelvas a instalar Glancy.
es.RenameFailed=El instalador no puede sustituir %1 porque otro programa lo está usando. Cierra las ventanas del Explorador de archivos y vuelve a intentarlo.
de.EngineRegisterFailed=Glancy wurde installiert, aber die Miniaturansicht-Engine konnte nicht registriert werden (Fehler %1). Die Miniaturansichten ändern sich erst, wenn sie registriert ist. Führen Sie dieses Setup erneut aus, um es noch einmal zu versuchen.
de.EngineUnregisterFailed=Die Registrierung der Miniaturansicht-Engine konnte nicht vollständig aufgehoben werden (Fehler %1). Die Sicherungen der vorherigen Miniaturansicht-Handler wurden beibehalten. Installieren Sie Glancy erneut, und deinstallieren Sie es dann, um es noch einmal zu versuchen.
de.DeleteSettings=Auch Ihre Glancy-Einstellungen und den Verlauf der verarbeiteten Dateien löschen?%n%nWählen Sie „Nein“, wenn Sie Glancy eventuell wieder installieren.
de.RenameFailed=Setup kann %1 nicht ersetzen, weil ein anderes Programm die Datei verwendet. Schließen Sie die Fenster des Datei-Explorers, und versuchen Sie es erneut.
fr.EngineRegisterFailed=Glancy a été installé, mais son moteur de miniatures n’a pas pu être inscrit (erreur %1). Les miniatures ne changeront pas tant qu’il ne l’est pas. Exécutez de nouveau ce programme d’installation pour réessayer.
fr.EngineUnregisterFailed=Le moteur de miniatures n’a pas pu être désinscrit complètement (erreur %1). Les sauvegardes des gestionnaires de miniatures précédents ont été conservées. Pour réessayer, réinstallez Glancy, puis désinstallez-le.
fr.DeleteSettings=Supprimer aussi vos paramètres Glancy et l’historique des fichiers traités ?%n%nChoisissez Non si vous pensez réinstaller Glancy.
fr.RenameFailed=Le programme d’installation ne peut pas remplacer %1, car un autre programme l’utilise. Fermez les fenêtres de l’Explorateur de fichiers et réessayez.
ptbr.EngineRegisterFailed=O Glancy foi instalado, mas não foi possível registrar o mecanismo de miniaturas (erro %1). As miniaturas não mudarão até que ele seja registrado. Execute este instalador novamente para tentar de novo.
ptbr.EngineUnregisterFailed=Não foi possível cancelar completamente o registro do mecanismo de miniaturas (erro %1). Os backups dos manipuladores de miniaturas anteriores foram mantidos. Para tentar de novo, instale o Glancy novamente e depois desinstale-o.
ptbr.DeleteSettings=Excluir também suas configurações do Glancy e o histórico de arquivos processados?%n%nEscolha Não se você talvez instale o Glancy novamente.
ptbr.RenameFailed=O instalador não pode substituir %1 porque outro programa está usando o arquivo. Feche as janelas do Explorador de Arquivos e tente novamente.
ja.EngineRegisterFailed=Glancy はインストールされましたが、縮小版エンジンを登録できませんでした (エラー %1)。登録されるまで縮小版は変わりません。もう一度このセットアップを実行してください。
ja.EngineUnregisterFailed=縮小版エンジンの登録を完全には解除できませんでした (エラー %1)。以前の縮小版ハンドラーのバックアップは保持されています。もう一度試すには、Glancy を再インストールしてからアンインストールしてください。
ja.DeleteSettings=Glancy の設定と処理済みファイルの履歴も削除しますか?%n%nGlancy を再びインストールする可能性がある場合は [いいえ] を選んでください。
ja.RenameFailed=%1 は別のプログラムで使用中のため、置き換えられません。エクスプローラーのウィンドウを閉じてから、もう一度お試しください。
zhhans.EngineRegisterFailed=Glancy 已安装，但无法注册其缩略图引擎（错误 %1）。注册之前缩略图不会改变。请再次运行此安装程序以重试。
zhhans.EngineUnregisterFailed=无法完全取消注册缩略图引擎（错误 %1）。已保留之前缩略图处理程序的备份。若要重试，请重新安装 Glancy，然后再将其卸载。
zhhans.DeleteSettings=是否同时删除 Glancy 设置和已处理文件的历史记录？%n%n如果你可能会再次安装 Glancy，请选择“否”。
zhhans.RenameFailed=安装程序无法替换 %1，因为另一个程序正在使用它。请关闭文件资源管理器窗口，然后重试。

[Code]
function EngineDir: String;
begin
  Result := ExpandConstant('{app}\Engine');
end;

function EngineDll: String;
begin
  Result := EngineDir + '\Glancy.Thumbnails.dll';
end;

function Stamp: String;
begin
  Result := GetDateTimeString('yyyymmddhhnnss', #0, #0);
end;

function IsFile(const FindRec: TFindRec): Boolean;
begin
  Result := (FindRec.Attributes and FILE_ATTRIBUTE_DIRECTORY) = 0;
end;

function RunHidden(const FileName, Params: String; var Code: Integer): Boolean;
begin
  Result := Exec(FileName, Params, '', SW_HIDE, ewWaitUntilTerminated, Code) and (Code = 0);
end;

{ Upgrade: Explorer keeps the engine loaded, so a file that can't be deleted is renamed out of the way (a loaded
  DLL can be renamed, not overwritten). Leftovers from earlier upgrades are deleted first. }
function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  FindRec: TFindRec;
  Path: String;
begin
  Result := '';
  if FindFirst(EngineDir + '\*.old-*', FindRec) then
  try
    repeat
      DeleteFile(EngineDir + '\' + FindRec.Name);
    until not FindNext(FindRec);
  finally
    FindClose(FindRec);
  end;
  if FindFirst(EngineDir + '\*.*', FindRec) then
  try
    repeat
      Path := EngineDir + '\' + FindRec.Name;
      if IsFile(FindRec) and (Pos('.old-', FindRec.Name) = 0) then
        if not DeleteFile(Path) then
          if not RenameFile(Path, Path + '.old-' + Stamp) then
          begin
            Result := FmtMessage(CustomMessage('RenameFailed'), [Path]);
            Exit;
          end;
    until not FindNext(FindRec);
  finally
    FindClose(FindRec);
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Code: Integer;
begin
  if CurStep = ssPostInstall then
    if not RunHidden(ExpandConstant('{sys}\regsvr32.exe'), '/s "' + EngineDll + '"', Code) then
      SuppressibleMsgBox(FmtMessage(CustomMessage('EngineRegisterFailed'), [IntToStr(Code)]), mbError, MB_OK, IDOK);
end;

{ Uninstall: files Explorer still holds are moved to the user's temp folder (same volume, so a loaded DLL can be
  moved) and that folder is deleted at the next sign-in through RunOnce, which needs no administrator rights. }
procedure MoveLockedEngineFiles;
var
  FindRec: TFindRec;
  Leftovers, Path: String;
begin
  Leftovers := AddBackslash(GetTempDir) + 'Glancy-uninstall-' + Stamp;
  if FindFirst(EngineDir + '\*.*', FindRec) then
  try
    repeat
      Path := EngineDir + '\' + FindRec.Name;
      if IsFile(FindRec) then
        if not DeleteFile(Path) then
          if ForceDirectories(Leftovers) then
            RenameFile(Path, Leftovers + '\' + FindRec.Name);
    until not FindNext(FindRec);
  finally
    FindClose(FindRec);
  end;
  if DirExists(Leftovers) then
    RegWriteStringValue(HKCU, 'Software\Microsoft\Windows\CurrentVersion\RunOnce', 'GlancyCleanup',
      'cmd.exe /c rd /s /q "' + Leftovers + '"');
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Code: Integer;
  Unregistered: Boolean;
begin
  if CurUninstallStep = usPostUninstall then
  begin
    { Inno removes only the folders it created; an install made by tools/install-engine.ps1 created these first. }
    RemoveDir(EngineDir + '\licenses');
    RemoveDir(EngineDir);
    RemoveDir(ExpandConstant('{app}'));
    Exit;
  end;
  if CurUninstallStep <> usUninstall then
    Exit;
  Exec(ExpandConstant('{sys}\taskkill.exe'), '/f /im Glancy.exe', '', SW_HIDE, ewWaitUntilTerminated, Code);
  { Removes the Jump List and the notification identity; failures are logged by the app and never block. }
  Exec(ExpandConstant('{app}\Glancy.exe'), '--cleanup', '', SW_HIDE, ewWaitUntilTerminated, Code);

  { The engine restores the previous providers, Treatment and TypeOverlay, and deletes Software\Glancy\Engine. If a
    restore fails it keeps that key (the backups), so it must not be deleted below. }
  Unregistered := True;
  if FileExists(EngineDll) then
    if not RunHidden(ExpandConstant('{sys}\regsvr32.exe'), '/s /u "' + EngineDll + '"', Code) then
    begin
      Unregistered := False;
      SuppressibleMsgBox(FmtMessage(CustomMessage('EngineUnregisterFailed'), [IntToStr(Code)]), mbError, MB_OK, IDOK);
    end;

  { Silent uninstalls keep the settings. }
  if not UninstallSilent then
    if SuppressibleMsgBox(CustomMessage('DeleteSettings'), mbConfirmation, MB_YESNO or MB_DEFBUTTON2, IDNO) = IDYES then
  begin
    if Unregistered then
      RegDeleteKeyIncludingSubkeys(HKCU, 'Software\Glancy')
    else
    begin
      RegDeleteKeyIncludingSubkeys(HKCU, 'Software\Glancy\Thumbnails');
      RegDeleteKeyIncludingSubkeys(HKCU, 'Software\Glancy\App');
    end;
    DelTree(ExpandConstant('{localappdata}\Glancy'), True, True, True);
  end;

  MoveLockedEngineFiles;
end;
