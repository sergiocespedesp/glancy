<Page x:Class="Glancy.Settings.Views.FormatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:Glancy.Settings.Localization"
      xmlns:c="using:Glancy.Settings.Controls"
      NavigationCacheMode="Disabled">
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="OnCopyAccelerator" />
    <KeyboardAccelerator Key="V" Modifiers="Control,Shift" Invoked="OnPasteAccelerator" />
  </Page.KeyboardAccelerators>

  <Grid x:Name="LayoutRoot" SizeChanged="OnLayoutSizeChanged">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1000*" MaxWidth="{StaticResource GlancyContentMaxWidth}" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
      <StackPanel x:Name="ContentPanel" Padding="{StaticResource GlancyPagePadding}" HorizontalAlignment="Stretch">

        <!-- Header -->
        <Grid ColumnSpacing="16" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:FormatBadge FormatId="{x:Bind ViewModel.FormatId}" Size="52" VerticalAlignment="Top" Margin="0,4,0,0" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock x:Name="PageTitle" Text="{x:Bind ViewModel.Title}" Style="{StaticResource GlancyPageTitleStyle}"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{x:Bind ViewModel.Description}" Style="{StaticResource GlancySecondaryTextStyle}" Margin="0,4,0,0" />
            <!-- Extensions: a wrapping grid built in code (Helpers/ExtensionList); a summary on "All formats" -->
            <Border x:Name="ExtensionsHost" Margin="0,6,0,0" />
          </StackPanel>
          <DropDownButton Grid.Column="2" VerticalAlignment="Top" AutomationProperties.Name="{l:Str Key=Format_MoreActions_Name}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE712;" FontSize="16" />
              <TextBlock Text="{l:Str Key=Format_More}" />
            </StackPanel>
            <DropDownButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnMoreMenuOpening">
                <MenuFlyoutItem x:Name="CopyItem" Text="{l:Str Key=Format_CopySettings}" Click="OnCopyClick">
                  <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                  <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C" Modifiers="Control,Shift" IsEnabled="False" />
                  </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="PasteItem" Text="{l:Str Key=Format_PasteSettings}" Click="OnPasteClick">
                  <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
                  <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="V" Modifiers="Control,Shift" IsEnabled="False" />
                  </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="RemoveOverridesItem" Text="{l:Str Key=Format_RemoveExtensionCustomization}" Click="OnRemoveOverridesClick">
                  <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE894;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ResetItem" Text="{l:Str Key=Format_ResetDefaults}" Click="OnResetScopeClick">
                  <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </Grid>

        <!-- Scope: whole format or one extension -->
        <StackPanel x:Name="ScopePanel" Visibility="{x:Bind ViewModel.HasMultipleExtensions}" Margin="0,20,0,0" Spacing="6">
          <TextBlock Text="{l:Str Key=Format_ApplyTo}" Style="{StaticResource GlancyCaptionStyle}" />
          <!-- Few extensions: a SelectorBar. Many (RAW has 35): a ComboBox, which stays usable at any width. -->
          <SelectorBar x:Name="ScopeBar" SelectionChanged="OnScopeChanged" AutomationProperties.Name="{l:Str Key=Format_ApplyTo}" />
          <ComboBox x:Name="ScopeCombo" Visibility="Collapsed" MinWidth="280" MaxDropDownHeight="420"
                    SelectionChanged="OnScopeComboChanged" AutomationProperties.Name="{l:Str Key=Format_ApplyTo}" />
          <Grid ColumnSpacing="10" Visibility="{x:Bind ViewModel.IsExtensionScope, Mode=OneWay}" Margin="2,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE946;" FontSize="14" Style="{StaticResource GlancyIconSecondaryStyle}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ExtensionScopeMessage, Mode=OneWay}" Style="{StaticResource GlancyCaptionStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="{l:Str Key=Format_RemoveCustomization}" Click="OnRemoveOverridesClick" VerticalAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.HasExtensionOverrides, Mode=OneWay}" />
          </Grid>
        </StackPanel>

        <Expander x:Name="InlinePreviewExpander" Header="{l:Str Key=Preview_Title}" IsExpanded="False" Visibility="Collapsed"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,16,0,0" />

        <!-- Generation -->
        <TextBlock Text="{l:Str Key=Group_Generation}" Style="{StaticResource GlancySectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
        <StackPanel Spacing="{StaticResource GlancyCardSpacing}">
          <c:SettingsCard Item="{x:Bind ViewModel.Mode}">
            <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" PlaceholderText="{l:Str Key=Common_MultipleValues}" DisplayMemberPath="Label"
                      ItemsSource="{x:Bind ViewModel.Mode.Options}" SelectedItem="{x:Bind ViewModel.Mode.SelectedOption, Mode=TwoWay}" />
          </c:SettingsCard>
          <c:SettingsCard Item="{x:Bind ViewModel.SmallIcons}">
            <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" PlaceholderText="{l:Str Key=Common_MultipleValues}" DisplayMemberPath="Label"
                      ItemsSource="{x:Bind ViewModel.SmallIcons.Options}" SelectedItem="{x:Bind ViewModel.SmallIcons.SelectedOption, Mode=TwoWay}" />
          </c:SettingsCard>
        </StackPanel>

        <!-- Appearance -->
        <TextBlock Text="{l:Str Key=Group_Appearance}" Style="{StaticResource GlancySectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
        <Grid ColumnSpacing="10" Visibility="{x:Bind ViewModel.AppearanceInactive, Mode=OneWay}" Margin="2,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE946;" FontSize="14" Style="{StaticResource GlancyIconSecondaryStyle}" VerticalAlignment="Top" Margin="0,2,0,0" />
          <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AppearanceInactiveMessage, Mode=OneWay}" Style="{StaticResource GlancyCaptionStyle}" />
        </Grid>
        <StackPanel Spacing="{StaticResource GlancyCardSpacing}">
          <c:SettingsCard Item="{x:Bind ViewModel.Transparency}">
            <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" PlaceholderText="{l:Str Key=Common_MultipleValues}" DisplayMemberPath="Label"
                      ItemsSource="{x:Bind ViewModel.Transparency.Options}" SelectedItem="{x:Bind ViewModel.Transparency.SelectedOption, Mode=TwoWay}" />
          </c:SettingsCard>
          <StackPanel Visibility="{x:Bind ViewModel.ShowChecker, Mode=OneWay}">
            <c:SettingsCard Item="{x:Bind ViewModel.Checker}">
              <c:CheckerButton Value="{x:Bind ViewModel.Checker.CheckerValue, Mode=OneWay}" ValueChosen="OnCheckerChosen" />
            </c:SettingsCard>
          </StackPanel>
          <StackPanel Visibility="{x:Bind ViewModel.ShowCanvasColor, Mode=OneWay}">
            <c:SettingsCard Item="{x:Bind ViewModel.CanvasColor}">
              <c:ColorButton Color="{x:Bind ViewModel.CanvasColor.ColorValue, Mode=OneWay}" ColorChosen="OnCanvasColorChosen" />
            </c:SettingsCard>
          </StackPanel>
          <c:SettingsCard Item="{x:Bind ViewModel.Scale}">
            <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" PlaceholderText="{l:Str Key=Common_MultipleValues}" DisplayMemberPath="Label"
                      ItemsSource="{x:Bind ViewModel.Scale.Options}" SelectedItem="{x:Bind ViewModel.Scale.SelectedOption, Mode=TwoWay}" />
          </c:SettingsCard>
          <c:SettingsCard Item="{x:Bind ViewModel.FullFill}">
            <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" PlaceholderText="{l:Str Key=Common_MultipleValues}" DisplayMemberPath="Label"
                      ItemsSource="{x:Bind ViewModel.FullFill.Options}" SelectedItem="{x:Bind ViewModel.FullFill.SelectedOption, Mode=TwoWay}" />
          </c:SettingsCard>
          <c:SettingsCard Item="{x:Bind ViewModel.Adornment}">
            <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" PlaceholderText="{l:Str Key=Common_MultipleValues}" DisplayMemberPath="Label"
                      ItemsSource="{x:Bind ViewModel.Adornment.Options}" SelectedItem="{x:Bind ViewModel.Adornment.SelectedOption, Mode=TwoWay}" />
          </c:SettingsCard>
        </StackPanel>

        <!-- Performance -->
        <TextBlock Text="{l:Str Key=Group_Performance}" Style="{StaticResource GlancySectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
        <StackPanel Spacing="{StaticResource GlancyCardSpacing}">
          <c:SettingsCard Item="{x:Bind ViewModel.Embedded}">
            <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" PlaceholderText="{l:Str Key=Common_MultipleValues}" DisplayMemberPath="Label"
                      ItemsSource="{x:Bind ViewModel.Embedded.Options}" SelectedItem="{x:Bind ViewModel.Embedded.SelectedOption, Mode=TwoWay}" />
          </c:SettingsCard>
          <c:SettingsCard Item="{x:Bind ViewModel.MaxFileSize}">
            <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" PlaceholderText="{l:Str Key=Common_MultipleValues}" DisplayMemberPath="Label"
                      ItemsSource="{x:Bind ViewModel.MaxFileSize.Options}" SelectedItem="{x:Bind ViewModel.MaxFileSize.SelectedOption, Mode=TwoWay}" />
          </c:SettingsCard>
          <c:SettingsCard Item="{x:Bind ViewModel.MaxPixels}">
            <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" PlaceholderText="{l:Str Key=Common_MultipleValues}" DisplayMemberPath="Label"
                      ItemsSource="{x:Bind ViewModel.MaxPixels.Options}" SelectedItem="{x:Bind ViewModel.MaxPixels.SelectedOption, Mode=TwoWay}" />
          </c:SettingsCard>
        </StackPanel>

        <!-- Overlay icon -->
        <TextBlock Text="{l:Str Key=Group_OverlayIcon}" Style="{StaticResource GlancySectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
        <StackPanel Spacing="{StaticResource GlancyCardSpacing}">
          <c:SettingsCard Item="{x:Bind ViewModel.ShowAssociationIcon}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.ShowAssociationIcon.IsOn, Mode=TwoWay}" OnContent="{l:Str Key=Common_On}" OffContent="{l:Str Key=Common_Off}" MinWidth="0" />
          </c:SettingsCard>
          <c:SettingsCard Item="{x:Bind ViewModel.CustomIcon}">
            <ToggleSwitch IsOn="{x:Bind ViewModel.CustomIcon.IsOn, Mode=TwoWay}" OnContent="{l:Str Key=Common_On}" OffContent="{l:Str Key=Common_Off}" MinWidth="0" />
          </c:SettingsCard>
          <StackPanel Visibility="{x:Bind ViewModel.ShowCustomIconPath, Mode=OneWay}">
            <c:SettingsCard Item="{x:Bind ViewModel.CustomIconPath}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="32" Height="32" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                  <Image x:Name="CustomIconImage" Width="24" Height="24" AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <Button Content="{l:Str Key=Format_ChooseIcon}" Click="OnChooseIconClick" />
              </StackPanel>
            </c:SettingsCard>
          </StackPanel>
        </StackPanel>

        <!-- Advanced: collapsed by default; nothing removed, just out of the way -->
        <StackPanel Visibility="{x:Bind ViewModel.HasAdvanced}" Margin="0,24,0,0" Spacing="8">
          <ToggleButton x:Name="AdvancedToggle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="16,12" Click="OnAdvancedToggle" AutomationProperties.Name="{l:Str Key=Format_Advanced}">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE9E9;" FontSize="20" Margin="4,0" />
              <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                <TextBlock Text="{l:Str Key=Format_Advanced}" Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock x:Name="AdvancedSummary" Style="{StaticResource GlancyCaptionStyle}" />
              </StackPanel>
              <FontIcon x:Name="AdvancedChevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="12" />
            </Grid>
          </ToggleButton>
          <StackPanel x:Name="AdvancedPanel" Spacing="{StaticResource GlancyCardSpacing}" Visibility="Collapsed">
            <c:SettingsCard Item="{x:Bind ViewModel.Sampling}">
              <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" PlaceholderText="{l:Str Key=Common_MultipleValues}" DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.Sampling.Options}" SelectedItem="{x:Bind ViewModel.Sampling.SelectedOption, Mode=TwoWay}" />
            </c:SettingsCard>
            <c:SettingsCard Item="{x:Bind ViewModel.Gamma}">
              <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" PlaceholderText="{l:Str Key=Common_MultipleValues}" DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.Gamma.Options}" SelectedItem="{x:Bind ViewModel.Gamma.SelectedOption, Mode=TwoWay}" />
            </c:SettingsCard>
            <c:SettingsCard Item="{x:Bind ViewModel.Alpha}">
              <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" PlaceholderText="{l:Str Key=Common_MultipleValues}" DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.Alpha.Options}" SelectedItem="{x:Bind ViewModel.Alpha.SelectedOption, Mode=TwoWay}" />
            </c:SettingsCard>
          </StackPanel>
        </StackPanel>

        <!-- Windows registration status -->
        <TextBlock Text="{l:Str Key=Format_WindowsStatus}" Style="{StaticResource GlancySectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
        <Border Style="{StaticResource GlancyCardStyle}">
          <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource GlancyCaptionStyle}"
                       Text="{l:Str Key=Format_WindowsStatus_Help}" />
            <ItemsControl x:Name="HandlersList" IsTabStop="False" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Preview pane (wide layouts). On narrow windows the same panel moves into InlinePreviewExpander. -->
    <Border x:Name="PreviewHost" Grid.Column="1" Width="{StaticResource GlancyPreviewPaneWidth}" Margin="0,28,24,24" VerticalAlignment="Top">
      <c:PreviewPanel x:Name="Preview" />
    </Border>
  </Grid>
</Page>
