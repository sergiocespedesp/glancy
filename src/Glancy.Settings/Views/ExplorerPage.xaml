<Page x:Class="Glancy.Settings.Views.ExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="using:Glancy.Settings.Localization"
      xmlns:c="using:Glancy.Settings.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1000*" MaxWidth="{StaticResource GlancyContentMaxWidth}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
    <StackPanel x:Name="ContentPanel" Padding="{StaticResource GlancyPagePadding}">
      <StackPanel Spacing="2" Margin="0,8,0,0">
        <TextBlock Text="{l:Str Key=Nav_Explorer}" Style="{StaticResource GlancyPageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{l:Str Key=Explorer_Subtitle}"
                   Style="{StaticResource GlancySecondaryTextStyle}" Margin="0,4,0,0" />
      </StackPanel>

      <TextBlock Text="{l:Str Key=Explorer_General}" Style="{StaticResource GlancySectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
      <StackPanel Spacing="{StaticResource GlancyCardSpacing}">
        <c:SettingsCard Item="{x:Bind Global.Enabled}">
          <ToggleSwitch IsOn="{x:Bind Global.Enabled.IsOn, Mode=TwoWay}" OnContent="{l:Str Key=Common_On}" OffContent="{l:Str Key=Common_Off}" MinWidth="0" />
        </c:SettingsCard>
        <c:SettingsCard Item="{x:Bind Global.ForceDesktopTransparency}">
          <ToggleSwitch IsOn="{x:Bind Global.ForceDesktopTransparency.IsOn, Mode=TwoWay}" OnContent="{l:Str Key=Common_On}" OffContent="{l:Str Key=Common_Off}" MinWidth="0" />
        </c:SettingsCard>
        <c:SettingsCard Item="{x:Bind Global.RefreshOnApply}">
          <ToggleSwitch IsOn="{x:Bind Global.RefreshOnApply.IsOn, Mode=TwoWay}" OnContent="{l:Str Key=Common_On}" OffContent="{l:Str Key=Common_Off}" MinWidth="0" />
        </c:SettingsCard>
      </StackPanel>

      <TextBlock Text="{l:Str Key=Explorer_ContextMenu}" Style="{StaticResource GlancySectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
      <StackPanel Spacing="{StaticResource GlancyCardSpacing}">
        <c:SettingsCard Item="{x:Bind Global.ContextMenu}">
          <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" DisplayMemberPath="Label"
                    ItemsSource="{x:Bind Global.ContextMenu.Options}" SelectedItem="{x:Bind Global.ContextMenu.SelectedOption, Mode=TwoWay}" />
        </c:SettingsCard>
        <c:SettingsCard Item="{x:Bind Global.ContextMenuShift}">
          <ToggleSwitch IsOn="{x:Bind Global.ContextMenuShift.IsOn, Mode=TwoWay}" IsEnabled="{x:Bind Global.IsContextMenuEnabled, Mode=OneWay}"
                        OnContent="{l:Str Key=Common_On}" OffContent="{l:Str Key=Common_Off}" MinWidth="0" />
        </c:SettingsCard>
        <c:SettingsCard Item="{x:Bind Global.FolderRecursion}">
          <ToggleSwitch IsOn="{x:Bind Global.FolderRecursion.IsOn, Mode=TwoWay}" OnContent="{l:Str Key=Common_On}" OffContent="{l:Str Key=Common_Off}" MinWidth="0" />
        </c:SettingsCard>
      </StackPanel>

      <TextBlock Text="{l:Str Key=Explorer_Privacy}" Style="{StaticResource GlancySectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
      <Border Style="{StaticResource GlancyCardStyle}">
        <StackPanel Spacing="12">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE72E;" FontSize="20" Margin="4,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind Global.BlockedFolders.Title}" Style="{StaticResource BodyTextBlockStyle}" />
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource GlancyPendingDotBrush}"
                         Visibility="{x:Bind Global.BlockedFolders.IsPending, Mode=OneWay}" />
              </StackPanel>
              <TextBlock Text="{x:Bind Global.BlockedFolders.Description}" Style="{StaticResource GlancyCaptionStyle}" />
            </StackPanel>
            <Button Grid.Column="2" Click="OnAddFolder" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
                <TextBlock Text="{l:Str Key=Explorer_AddFolder}" />
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock x:Name="NoFoldersText" Text="{l:Str Key=Explorer_NoExcludedFolders}" Style="{StaticResource GlancyCaptionStyle}" Margin="44,0,0,0" />
          <ItemsControl x:Name="FoldersList" IsTabStop="False" Margin="40,0,0,0" />
        </StackPanel>
      </Border>

      <TextBlock Text="{l:Str Key=Explorer_Checkerboard}" Style="{StaticResource GlancySectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
      <StackPanel Spacing="{StaticResource GlancyCardSpacing}">
        <c:SettingsCard Item="{x:Bind Global.CheckerAnchor}">
          <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" DisplayMemberPath="Label"
                    ItemsSource="{x:Bind Global.CheckerAnchor.Options}" SelectedItem="{x:Bind Global.CheckerAnchor.SelectedOption, Mode=TwoWay}" />
        </c:SettingsCard>
        <c:SettingsCard Item="{x:Bind Global.CheckerScale}">
          <ComboBox Style="{StaticResource GlancySettingComboBoxStyle}" DisplayMemberPath="Label"
                    ItemsSource="{x:Bind Global.CheckerScale.Options}" SelectedItem="{x:Bind Global.CheckerScale.SelectedOption, Mode=TwoWay}" />
        </c:SettingsCard>
        <Border Style="{StaticResource GlancyCardStyle}">
          <StackPanel Spacing="12">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE8F1;" FontSize="20" Margin="4,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{x:Bind Global.CheckerLibrary.Title}" Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock Text="{l:Str Key=Explorer_Checkerboard_Help}"
                           Style="{StaticResource GlancyCaptionStyle}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="RemoveSwatchesButton" Content="{l:Str Key=Explorer_RemoveSelected}" Click="OnRemoveSwatches" IsEnabled="False" />
                <Button Content="{l:Str Key=Explorer_Restore}" Click="OnRestoreLibrary" ToolTipService.ToolTip="{l:Str Key=Explorer_Restore_Tooltip}" />
              </StackPanel>
            </Grid>
            <GridView x:Name="LibraryView" SelectionMode="Multiple" Margin="40,0,0,0" SelectionChanged="OnSwatchSelectionChanged"
                      AutomationProperties.Name="{l:Str Key=Explorer_Library_Name}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
