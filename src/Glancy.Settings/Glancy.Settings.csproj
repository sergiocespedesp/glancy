<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Glancy.Settings</RootNamespace>
    <AssemblyName>Glancy</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Glancy.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Custom Main for single-instance activation and the capture QA mode. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- The UI languages (docs/localization.md); also trims other languages from the Windows App SDK. -->
    <SatelliteResourceLanguages>en;es;de;fr;pt-BR;ja;zh-Hans</SatelliteResourceLanguages>
    <!-- WinUI's .mui strings (text menus, control type names) load in the culture Program.ApplyLanguage picks for the
         UI language: the cultures listed in AppLanguage.WinUICultures, which a test keeps equal to this list. -->
    <GlancyWinUILanguages>en-us;en-GB;es-ES;es-MX;de-DE;fr-FR;fr-CA;pt-BR;ja-JP;zh-CN</GlancyWinUILanguages>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- UI strings: English base + translations, read through the generated AppStrings class and {l:Str}. -->
    <EmbeddedResource Update="Resources\AppStrings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)AppStrings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Glancy.Settings.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>AppStrings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
  <!-- The XAML compiler builds the project's own types (Localization.Str uses AppStrings) before resources are
       generated by default: generate them first so AppStrings.Designer.cs is already a Compile item. -->
  <Target Name="GlancyGenerateStringsBeforeXaml" BeforeTargets="MarkupCompilePass1" DependsOnTargets="PrepareResourceNames;ResGen" />
  <!-- The self-contained Windows App SDK adds every component file, .mui of all its languages included, as None items
       linked to <culture>\<file>; no property filters them, so drop the cultures not in GlancyWinUILanguages. -->
  <Target Name="GlancyRemoveUnusedWinUILanguages" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <PropertyGroup>
      <_GlancyWinUILanguages>;$(GlancyWinUILanguages.ToLowerInvariant());</_GlancyWinUILanguages>
    </PropertyGroup>
    <ItemGroup>
      <_GlancyUnusedMui Include="@(None)" Condition="'%(None.Extension)' == '.mui' and
          !$(_GlancyWinUILanguages.Contains(';$([System.IO.Path]::GetDirectoryName('%(None.Link)').ToLowerInvariant());'))" />
      <None Remove="@(_GlancyUnusedMui)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Only the Windows App SDK components Glancy uses (the metapackage would also ship AI/ML/Search/Widgets, ~100 MB). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Glancy.Core\Glancy.Core.csproj" />
  </ItemGroup>
</Project>
