<!--
  Glancy design tokens. Everything visual derives from these values or from Fluent system resources
  (TextFillColor*, CardBackgroundFillColor*, AccentFillColor*...), so light, dark and high contrast
  themes come for free. See docs/design-system.md.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Typography -->
  <FontFamily x:Key="GlancyDisplayFontFamily">Segoe UI Variable Display</FontFamily>
  <FontFamily x:Key="GlancyTextFontFamily">Segoe UI Variable Text</FontFamily>
  <FontFamily x:Key="GlancyIconFontFamily">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
  <!-- Brand typeface (docs/brand-identity.md): only the "Glancy" title in the Home hero. Shipped under the OFL. -->
  <FontFamily x:Key="GlancyBrandFontFamily">ms-appx:///Assets/Fonts/Sora-SemiBold.ttf#Sora</FontFamily>

  <!-- Spacing scale (4 px grid) -->
  <x:Double x:Key="GlancySpace1">4</x:Double>
  <x:Double x:Key="GlancySpace2">8</x:Double>
  <x:Double x:Key="GlancySpace3">12</x:Double>
  <x:Double x:Key="GlancySpace4">16</x:Double>
  <x:Double x:Key="GlancySpace6">24</x:Double>
  <x:Double x:Key="GlancySpace8">32</x:Double>

  <!-- Layout -->
  <x:Double x:Key="GlancyContentMaxWidth">1000</x:Double>
  <x:Double x:Key="GlancyPreviewPaneWidth">296</x:Double>
  <Thickness x:Key="GlancyPagePadding">36,20,36,40</Thickness>
  <Thickness x:Key="GlancyPagePaddingCompact">16,12,16,32</Thickness>
  <Thickness x:Key="GlancyCardPadding">16,12,16,12</Thickness>
  <x:Double x:Key="GlancyCardMinHeight">68</x:Double>
  <x:Double x:Key="GlancyCardSpacing">4</x:Double>
  <x:Double x:Key="GlancyActionMinWidth">200</x:Double>

  <!-- Shape -->
  <CornerRadius x:Key="GlancyCardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="GlancyTileCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="GlancyBadgeCornerRadius">6</CornerRadius>

  <!-- Motion (ms) — respected only when Windows animation effects are on -->
  <x:Double x:Key="GlancyMotionFast">83</x:Double>
  <x:Double x:Key="GlancyMotionNormal">167</x:Double>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <LinearGradientBrush x:Key="GlancyHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14FF5E62" Offset="0" />
        <GradientStop Color="#0DFFD166" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="GlancyExplorerSurfaceBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="GlancyExplorerTextBrush" Color="#FF1A1A1A" />
      <SolidColorBrush x:Key="GlancyPendingDotBrush" Color="{ThemeResource SystemAccentColorDark1}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <LinearGradientBrush x:Key="GlancyHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#29FF5E62" Offset="0" />
        <GradientStop Color="#14FFD166" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="GlancyExplorerSurfaceBrush" Color="#FF191919" />
      <SolidColorBrush x:Key="GlancyExplorerTextBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="GlancyPendingDotBrush" Color="{ThemeResource SystemAccentColorLight2}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="GlancyHeroBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GlancyExplorerSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GlancyExplorerTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GlancyPendingDotBrush" Color="{ThemeResource SystemColorHighlightColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
