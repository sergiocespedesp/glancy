<UserControl x:Class="Glancy.Settings.Controls.SettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Glancy.Settings.Localization"
             IsTabStop="False">
  <Grid x:Name="Root"
        MinHeight="{StaticResource GlancyCardMinHeight}"
        Padding="{StaticResource GlancyCardPadding}"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource GlancyCardCornerRadius}"
        ColumnSpacing="16"
        RowSpacing="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <FontIcon x:Name="IconElement"
              Glyph="{x:Bind Glyph, Mode=OneWay}"
              FontFamily="{StaticResource GlancyIconFontFamily}"
              FontSize="20"
              VerticalAlignment="Center"
              Margin="4,0,4,0"
              AutomationProperties.AccessibilityView="Raw" />

    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="HeaderText" Text="{x:Bind Header, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
        <Ellipse x:Name="PendingDot" Width="7" Height="7" VerticalAlignment="Center"
                 Fill="{ThemeResource GlancyPendingDotBrush}" Visibility="Collapsed"
                 ToolTipService.ToolTip="{l:Str Key=SettingsCard_Pending_Tooltip}" />
      </StackPanel>
      <TextBlock x:Name="DescriptionText" Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource GlancyCaptionStyle}" />
      <TextBlock x:Name="HintText" Style="{StaticResource GlancyCaptionStyle}" Visibility="Collapsed" Margin="0,1,0,0" />
      <TextBlock x:Name="StatusTextBlock" Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource GlancyCaptionStyle}"
                 FontStyle="Italic" Visibility="Collapsed" Margin="0,2,0,0" />
    </StackPanel>

    <Button x:Name="ResetButton" Grid.Column="2"
            Style="{StaticResource GlancySubtleIconButtonStyle}"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            Click="OnResetClick"
            AutomationProperties.Name="{l:Str Key=SettingsCard_Reset_Name}">
      <FontIcon Glyph="&#xE777;" FontSize="14" FontFamily="{StaticResource GlancyIconFontFamily}" />
    </Button>

    <ContentPresenter x:Name="ActionPresenter" Grid.Column="3"
                      Content="{x:Bind Action, Mode=OneWay}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right" />
  </Grid>
</UserControl>
